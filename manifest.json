{
    "$schema": "https://prestoworld.pages.dev/schemas/module-manifest/v1.json",
    "name": "ecommerce",
    "version": "1.0.0",
    "description": "Core e-commerce module: domain storage, repositories and shared upstream integration for Bookowl middleman modules",
    "type": "support",
    "priority": 30,
    "enabled": true,
    "namespace": "PrestoWorld\\Modules\\Ecommerce",
    "entry": "Module.php",
    "requires": {
        "php": "^8.1"
    },
    "dependencies": {
        "headless-cms": "^1.0.0"
    },
    "providers": [],
    "route_prefix": "",
    "routes": [],
    "headless": {
        "providers": {
            "ecommerce": "PrestoWorld\\Modules\\Ecommerce\\Headless\\EcommerceProvider"
        }
    },
    "provides": [
        "ecommerce.storage",
        "ecommerce.upstream",
        "ecommerce.headless"
    ],
    "autoload": {
        "psr-4": {
            "PrestoWorld\\Modules\\Ecommerce\\": "."
        }
    },
    "screens": {
        "products": "ecommerce-screens",
        "customers": "ecommerce-screens",
        "orders": "ecommerce-screens",
        "bills": "ecommerce-screens",
        "ecom": "ecommerce-screens",
        "invoices": "ecommerce-screens"
    }
}
