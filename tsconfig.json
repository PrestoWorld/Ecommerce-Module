{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["vite/client"],
    "paths": {
      "@presto/editor": ["../../shared/rich-text-editor/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
